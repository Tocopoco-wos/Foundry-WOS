</article>

</main>

<script>
(function () {
  var KEY = 'foundry-lang';

  function setLang(lang) {
    var en = document.getElementById('en');
    var tr = document.getElementById('tr');
    var buttons = document.querySelectorAll('[data-lang]');
    var i;
    en.hidden = lang !== 'en';
    tr.hidden = lang !== 'tr';
    document.documentElement.lang = lang;
    for (i = 0; i < buttons.length; i++) {
      buttons[i].setAttribute('aria-pressed', buttons[i].getAttribute('data-lang') === lang ? 'true' : 'false');
    }
    try { localStorage.setItem(KEY, lang); } catch (e) {}
  }

  function onClick(e) {
    var lang = e.currentTarget.getAttribute('data-lang');
    setLang(lang);
    window.scrollTo(0, 0);
  }

  var start = 'en';
  try {
    var saved = localStorage.getItem(KEY);
    if (saved === 'en' || saved === 'tr') { start = saved; }
  } catch (e) {}
  if (location.hash === '#tr') { start = 'tr'; }
  if (location.hash === '#en') { start = 'en'; }

  document.getElementById('btn-en').addEventListener('click', onClick);
  document.getElementById('btn-tr').addEventListener('click', onClick);
  setLang(start);
})();
</script>
